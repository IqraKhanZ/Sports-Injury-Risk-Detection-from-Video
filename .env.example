# =================================================================
# SPORTS INJURY RISK DETECTION (SIRD) - ENVIRONMENT TEMPLATE
# =================================================================
# Copy this file to .env and replace placeholders with your credentials:
# cp .env.example .env

# --- Database (MongoDB Atlas) ---
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.ikewtpy.mongodb.net/sports_injury?appName=Cluster0
DB_NAME=sports_injury

# --- Authentication & Security ---
JWT_SECRET_KEY=your_random_generated_secret_key_here
JWT_ALGORITHM=HS256

# --- Google OAuth2 Single Sign-On ---
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# --- AI Diagnostics (Google Gemini Agent) ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Cloudinary Storage (Videos, Thumbnails, PDF Reports) ---
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# --- Client & Server URLs (Docker Defaults) ---
FRONTEND_URL=http://localhost
VITE_API_URL=http://localhost:8000
HOST=0.0.0.0
PORT=8000
